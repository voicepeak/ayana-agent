{
  "name": "ayana-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ayana desktop companion and repository workshop",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "start": "electron .",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@kungal/ui-core": "2.56.2",
    "@kungal/ui-tokens": "2.56.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3",
    "tailwindcss": "^4.2.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "dev.ayana.agent",
    "electronDist": "node_modules/electron/dist",
    "productName": "Ayana",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json", "THIRD_PARTY_NOTICES.md"],
    "extraResources": [
      { "from": "../../.runtime/backend", "to": "backend", "filter": ["**/*", "!**/__pycache__/**"] },
      { "from": "../../.runtime/python", "to": "python", "filter": ["**/*", "!**/__pycache__/**"] }
    ],
    "win": { "target": "portable", "icon": "public/icon.ico", "signAndEditExecutable": false },
    "portable": { "artifactName": "Ayana-${version}-win-${arch}.exe" }
  }
}
