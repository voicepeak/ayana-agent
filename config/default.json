{
  "hotkey": "CommandOrControl+Alt+A",
  "cancel_hotkey": "CommandOrControl+Alt+Space",
  "provider": "local",
  "base_url": "https://api.openai.com/v1",
  "model": "",
  "api_key_env": "AYANA_API_KEY",
  "send_screenshot": true,
  "native_tools": true,
  "full_access": false,
  "search_proxy": "",
  "search_provider": "auto",
  "max_utterances": 8,
  "detailed_max_utterances": 32,
  "model_max_tokens": 6000,
  "task_limits": {"rounds": 12, "calls": 24, "seconds": 180},
  "max_audio_ahead_ms": 10000,
  "voice": {"voice_mode": "auto"},
  "stt": {"provider": "local", "model": "tiny"},
  "avatar_root": "assets/ayana",
  "avatar_costume": "校服",
  "sentence_motion": true,
  "volume": 1,
  "subtitles": true,
  "save_history": true
}
