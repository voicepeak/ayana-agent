  {
    "name": "files.read",
    "description": "读取文本；可按 start_line/max_lines 分段。普通模式 root_id 为 repository 或授权目录 ID；Full access 可用 root_id=filesystem 加任意绝对路径。省略 root_id 时优先仓库，否则 output。完整 UTF-8 文件返回 sha256；修改前必须完整读取",
    "arguments": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "effect": "read"
  },
  {
    "name": "files.create",
    "description": "执行模式：在授权目录创建新文本文件，绝不覆盖",
    "arguments": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40000
        }
      },
      "required": [
        "root_id",
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "effect": "write"
  },
  {
    "name": "files.propose_edit",
    "description": "读取后，用 base_sha256 和完整新内容修改文件。Full access 直接应用并保存备份；普通模式提出差异等待用户确认",
    "arguments": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "base_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "content": {
          "type": "string",
          "maxLength": 40000
        }
      },
      "required": [
        "root_id",
        "path",
        "base_sha256",
        "content"
      ],
      "additionalProperties": false
    },
    "effect": "preview"
  },
  {
    "name": "files.propose_restore",
    "description": "恢复 artifact_id 的备份。Full access 直接恢复；普通模式生成差异等待确认",
    "arguments": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "artifact_id"
      ],
      "additionalProperties": false
    },
    "effect": "preview"
  },
  {
    "name": "apps.search",
