      ],
      "additionalProperties": false
    },
    "effect": "write"
  },
  {
    "name": "files.list",
    "description": "列举授权范围的文件和目录。root_id 省略时优先当前只读仓库 repository，否则 output；path 为空列举根。recursive 递归列举，text_only 仅列文本，遍历有上限",
    "arguments": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "maxLength": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "recursive": {
          "type": "boolean"
        },
        "text_only": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "effect": "read"
  },
  {
    "name": "files.find",
