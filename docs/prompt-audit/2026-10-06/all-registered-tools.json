  {
    "name": "files.search",
    "description": "在授权范围的文本内容中搜索，返回路径、行号和原文。root_id 省略时优先当前只读仓库，否则 output；最多检查 400 文件，每文件 64 KiB。不按文件名匹配",
    "arguments": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "maxLength": 1000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "effect": "read"
  },
  {
    "name": "files.open",
    "description": "执行模式：打开授权目录内真实文件或目录；可选 app_id 为 apps.search 返回的应用 ID，用指定文档应用打开该文件。省略 app_id 时文本用记事本，其他文件用默认应用。不支持的指定应用返回原因，可用桌面工具继续。不能执行脚本或传任意参数；open_requested 仍需核实目标文件",
    "arguments": {
      "type": "object",
      "properties": {
        "root_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "type": "string",
          "maxLength": 1000
        },
        "app_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "root_id",
        "path"
      ],
      "additionalProperties": false
    },
    "effect": "write"
  },
