  {
    "name": "computer.run",
    "description": "执行模式：在用户绑定的当前窗口完成明确要求的桌面任务。自动观察、输入或点击、核实结果；不能启动应用、跨窗口操作或执行命令。只有用户要求操作桌面时使用。",
    "arguments": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "goal"
      ],
      "additionalProperties": false
    },
    "effect": "write"
  },
  {
    "name": "web.search",
    "description": "公网搜索；重要结论继续 web.fetch 核对原文",
    "arguments": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "effect": "read"
  },
